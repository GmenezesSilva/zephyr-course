# 9 "C:/Users/mene_/zephyr/boards/seeed/xiao_esp32c5/xiao_esp32c5_hpcore.dts" 2
# 1 "C:/Users/mene_/zephyr/boards/seeed/xiao_esp32c5/xiao_esp32c5-pinctrl.dtsi" 1







&pinctrl {
 uart0_default: uart0_default {
  group1 {
   pinmux = <(((11 & 0x3FU) << 0U) | ((0x1FFU & 0x1FFU) << 6U) | ((6 & 0x1FFU) << 15U))>;
   output-high;
  };

  group2 {
   pinmux = <(((12 & 0x3FU) << 0U) | ((6 & 0x1FFU) << 6U) | ((0x1FFU & 0x1FFU) << 15U))>;
   bias-pull-up;
  };
 };

 spim2_default: spim2_default {
  group1 {
   pinmux = <(((9 & 0x3FU) << 0U) | ((57 & 0x1FFU) << 6U) | ((0x1FFU & 0x1FFU) << 15U))>,
     <(((8 & 0x3FU) << 0U) | ((0x1FFU & 0x1FFU) << 6U) | ((56 & 0x1FFU) << 15U))>;
  };

  group2 {
   pinmux = <(((10 & 0x3FU) << 0U) | ((0x1FFU & 0x1FFU) << 6U) | ((58 & 0x1FFU) << 15U))>;
   output-low;
  };
 };

 i2c0_default: i2c0_default {
  group1 {
   pinmux = <(((23 & 0x3FU) << 0U) | ((47 & 0x1FFU) << 6U) | ((47 & 0x1FFU) << 15U))>,
     <(((24 & 0x3FU) << 0U) | ((46 & 0x1FFU) << 6U) | ((46 & 0x1FFU) << 15U))>;
   bias-pull-up;
   drive-open-drain;
   output-high;
  };
 };
};
