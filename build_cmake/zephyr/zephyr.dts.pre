/ {
 xiao_d: connector {
  compatible = "seeed,xiao-gpio";
  #gpio-cells = <2>;
  gpio-map-mask = <0xffffffff 0xffffffc0>;
  gpio-map-pass-thru = <0 0x3f>;
  gpio-map = <0 0 &gpio0 1 0>,
      <1 0 &gpio0 0 0>,
      <2 0 &gpio0 25 0>,
      <3 0 &gpio0 7 0>,
      <4 0 &gpio0 23 0>,
      <5 0 &gpio0 24 0>,
      <6 0 &gpio0 11 0>,
      <7 0 &gpio0 12 0>,
      <8 0 &gpio0 8 0>,
      <9 0 &gpio0 9 0>,
      <10 0 &gpio0 10 0>;
 };
};

xiao_i2c: &i2c0 {};

xiao_spi: &spi2 {};

xiao_serial: &uart0 {};

xiao_adc: &adc0 {};
