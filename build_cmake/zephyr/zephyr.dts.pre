 status = "okay";
};

&i2c0 {
 status = "okay";
 clock-frequency = <400000>;
 scl-gpios = <&gpio0 24 ((1 << 1) | (1 << 2))>;
 sda-gpios = <&gpio0 23 ((1 << 1) | (1 << 2))>;
 pinctrl-0 = <&i2c0_default>;
 pinctrl-names = "default";
};

&spi2 {
