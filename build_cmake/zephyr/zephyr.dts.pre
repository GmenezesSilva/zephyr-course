/ {
 #address-cells = <1>;
 #size-cells = <1>;

 aliases {
  die-temp0 = &coretemp;
  retainedmemdevice = &retainedmem0;
 };

 chosen {
  zephyr,canbus = &twai0;
  zephyr,entropy = &trng0;
  zephyr,flash-controller = &flash;
  zephyr,bt-hci = &esp32_bt_hci;
 };

 cpus {
  #address-cells = <1>;
  #size-cells = <0>;

  cpu0: cpu@0 {
   device_type = "cpu";
   compatible = "espressif,riscv", "riscv";
   riscv,isa-base = "rv32i";
   riscv,isa-extensions = "i", "m", "a", "c", "zicsr", "zifencei";
   reg = <0>;
   cpu-power-states = <&light_sleep &deep_sleep>;
   clock-source = <1U>;
   clock-frequency = <(((240) * 1000) * 1000)>;
   xtal-freq = <(((48) * 1000) * 1000)>;
   d-cache-line-size = <32>;
  };

  power-states {
   light_sleep: light_sleep {
    compatible = "zephyr,power-state";
    power-state-name = "standby";
    min-residency-us = <2500>;
    exit-latency-us = <50>;
   };

   deep_sleep: deep_sleep {



    compatible = "zephyr,power-state";
    power-state-name = "soft-off";
    status = "disabled";
   };
  };
 };

 pinctrl: pin-controller {
  compatible = "espressif,esp32-pinctrl";
  status = "okay";
 };

 esp32_bt_hci: esp32_bt_hci {
  compatible = "espressif,esp32-bt-hci";
  bt-hci-vs-ext;
  status = "disabled";
 };

 clock: clock {
  compatible = "espressif,esp32-clock";
  fast-clk-src = <0>;
  slow-clk-src = <0>;
  #clock-cells = <1>;
  status = "okay";
 };

 wifi: wifi {
  compatible = "espressif,esp32-wifi";
  status = "disabled";
 };

 ieee802154: ieee802154 {
  compatible = "espressif,esp32-ieee802154";
  status = "disabled";
 };

 ana_cmpr0: ana_cmpr0 {
  compatible = "espressif,esp32-ana-cmpr";
  unit = <0>;
  interrupts = <32 0 0>;
  interrupt-parent = <&intc>;
  status = "disabled";
 };

 soc {
  #address-cells = <1>;
  #size-cells = <1>;
  compatible = "simple-bus";
  ranges;






  soc_rom: memory@40000000 {
   compatible = "zephyr,memory-region";
   reg = <0x40000000 ((320) * 1024)>;
   zephyr,memory-region = "SOC_ROM";
  };

  sramhp: memory@40800000 {
   compatible = "zephyr,memory-region", "mmio-sram";
   reg = <0x40800000 ((384) * 1024)>;
   zephyr,memory-region = "SRAMHP";
  };

  sramlp: memory@50000000 {
   #address-cells = <1>;
   #size-cells = <1>;
   compatible = "zephyr,memory-region", "mmio-sram";
   reg = <0x50000000 ((16) * 1024)>;
   zephyr,memory-region = "SRAMLP";
   ranges = <0x0 0x50000000 ((16) * 1024)>;

   ulp_ram: memory@0 {
    compatible = "zephyr,memory-region", "mmio-sram";
    reg = <0x0 0x3c00>;
    zephyr,memory-region = "SRAMLP_ULP";
   };

   ulp_shm: memory@3c00 {
    compatible = "zephyr,memory-region", "mmio-sram";
    reg = <0x3c00 0x10>;
    zephyr,memory-region = "SRAMLP_ULP_SHM";
   };

   lp_rtc: memory@3c10 {
    compatible = "zephyr,memory-region", "mmio-sram";
    reg = <0x3c10 0xe8>;
    zephyr,memory-region = "SRAMLP_RTC";
   };

   retainedmem: memory@3cf8 {
    compatible = "zephyr,memory-region", "mmio-sram";
    reg = <0x3cf8 0x200>;
    ranges = <0x0 0x3cf8 0x200>;
    zephyr,memory-region = "SRAMLP_RETAINED_MEM";
    status = "okay";
    #address-cells = <1>;
    #size-cells = <1>;

    retainedmem0: retainedmem {
     compatible = "zephyr,retained-ram";
     status = "okay";
     ranges;
     #address-cells = <1>;
     #size-cells = <1>;
    };
   };

   ipc_shm: memory@3ef8 {
    compatible = "zephyr,memory-region", "mmio-sram";
    reg = <0x3ef8 0x100>;
    zephyr,memory-region = "SRAMLP_IPC_SHM";
   };

   mbox0: mbox@3ff8 {
    compatible = "espressif,mbox-esp32";
    reg = <0x3ff8 0x8>;
    status = "okay";
    shared-memory = <&ipc_shm>;
    shared-memory-size = <0x100>;
    interrupts = <13 0 0>,
          <5 0 0>;
    interrupt-parent = <&intc>;
    #mbox-cells = <1>;
   };
  };

  ext_ram: memory@42000000 {
   compatible = "zephyr,memory-region";
   reg = <0x42000000 (((32) * 1024) * 1024)>;
   zephyr,memory-region = "EXTRAM";

   psram0: psram0 {
    compatible = "espressif,esp32-psram";
    size = <0x0>;
   };
  };

  intc: interrupt-controller@60010000 {
   compatible = "espressif,esp32-intc";
   #address-cells = <0>;
   #interrupt-cells = <3>;
   interrupt-controller;
   reg = <0x60010000 ((4) * 1024)>;
   status = "okay";
  };

  systimer0: systimer@6000a000 {
   compatible = "espressif,esp32-systimer";
   reg = <0x6000a000 ((4) * 1024)>;
   interrupts = <61 0 0>;
   interrupt-parent = <&intc>;
   status = "okay";
  };

  timer0: counter@60008000 {
   compatible = "espressif,esp32-timer";
   reg = <0x60008000 ((4) * 1024)>;
   clocks = <&clock 0>;
   group = <0>;
   index = <0>;
   interrupts = <57 0 0>;
   interrupt-parent = <&intc>;
   status = "disabled";

   counter {
    compatible = "espressif,esp32-counter";
    status = "disabled";
   };
  };

  timer1: counter@60009000 {
   compatible = "espressif,esp32-timer";
   reg = <0x60009000 ((4) * 1024)>;
   clocks = <&clock 1>;
   group = <1>;
   index = <0>;
   interrupts = <59 0 0>;
   interrupt-parent = <&intc>;
   status = "disabled";

   counter {
    compatible = "espressif,esp32-counter";
    status = "disabled";
   };
  };

  rtc_timer: rtc_timer@600b0c00 {
   compatible = "espressif,esp32-rtc-timer";
   reg = <0x600b0c00 ((1) * 1024)>;
   clocks = <&clock 13>;
   interrupts = <15 0 0>;
   interrupt-parent = <&intc>;
   status = "disabled";
  };

  trng0: trng@600b2808 {
   compatible = "espressif,esp32-trng";
   reg = <0x600b2808 0x4>;
   clocks = <&clock 112>;
   status = "disabled";
  };

  twai0: can@6000b000 {
   compatible = "espressif,esp32-twaifd";
   reg = <0x6000b000 ((4) * 1024)>;
   interrupts = <50 0 0>;
   interrupt-parent = <&intc>;
   clocks = <&clock 110>;
   status = "disabled";
  };

  twai1: can@6000d000 {
   compatible = "espressif,esp32-twaifd";
   reg = <0x6000d000 ((4) * 1024)>;
   interrupts = <52 0 0>;
   interrupt-parent = <&intc>;
   clocks = <&clock 111>;
   status = "disabled";
  };

  spi2: spi@60081000 {
   compatible = "espressif,esp32-spi";
   reg = <0x60081000 ((4) * 1024)>;
   interrupts = <77 0 0>;
   interrupt-parent = <&intc>;
   clocks = <&clock 109>;
   dma-host = <0>;
   status = "disabled";
  };

  wdt0: watchdog@60008048 {
   compatible = "espressif,esp32-watchdog";
   reg = <0x60008048 0x20>;
   interrupts = <58 0 0>;
   interrupt-parent = <&intc>;
   clocks = <&clock 0>;
   status = "disabled";
  };

  wdt1: watchdog@60009048 {
   compatible = "espressif,esp32-watchdog";
   reg = <0x60009048 0x20>;
   interrupts = <60 0 0>;
   interrupt-parent = <&intc>;
   clocks = <&clock 1>;
   status = "disabled";
  };

  flash: flash-controller@60002000 {
   compatible = "espressif,esp32-flash-controller";
   reg = <0x60002000 0x1000>;

   #address-cells = <1>;
   #size-cells = <1>;
   ranges;

   flash0: flash@0 {
    compatible = "soc-nv-flash";
    erase-block-size = <4096>;
    write-block-size = <4>;
    #address-cells = <1>;
    #size-cells = <1>;

   };
  };

  coretemp: coretemp@6000e058 {
   compatible = "espressif,esp32-temp";
   friendly-name = "coretemp";
   reg = <0x6000e058 0x4>;
   status = "disabled";
  };

  adc0: adc@6000e000 {
   compatible = "espressif,esp32-adc";
   reg = <0x6000e000 4>;
   clocks = <&clock 118>;
   unit = <1>;
   channel-count = <6>;
   #io-channel-cells = <1>;
   status = "disabled";
  };

  dma: dma@60080000 {
   compatible = "espressif,esp32-gdma";
   reg = <0x60080000 ((4) * 1024)>;
   #dma-cells = <1>;
   interrupts = <71 0 0>,
         <74 0 0>,
         <72 0 0>,
         <75 0 0>,
         <73 0 0>,
         <76 0 0>;
   interrupt-parent = <&intc>;
   clocks = <&clock 113>;
   dma-channels = <6>;
   dma-buf-addr-alignment = <4>;
   status = "disabled";
  };

  gpio0: gpio@60091000 {
   compatible = "espressif,esp32-gpio";
   gpio-controller;
   #gpio-cells = <2>;
   reg = <0x60091000 ((4) * 1024)>;
   interrupts = <31 0 0>;
   interrupt-parent = <&intc>;
   ngpios = <29>;
  };

  i2c0: i2c@60004000 {
   compatible = "espressif,esp32-i2c";
   #address-cells = <1>;
   #size-cells = <0>;
   reg = <0x60004000 0x1000>;
   interrupts = <56 0 0>;
   interrupt-parent = <&intc>;
   clocks = <&clock 104>;
   status = "disabled";
  };

  i2s: i2s@6000c000 {
   compatible = "espressif,esp32-i2s";
   #address-cells = <1>;
   #size-cells = <0>;
   reg = <0x6000c000 0x1000>;
   interrupts = <45 0 0>;
   interrupt-parent = <&intc>;
   clocks = <&clock 105>;
   dmas = <&dma 2>, <&dma 3>;
   dma-names = "rx", "tx";
   unit = <0>;
   status = "disabled";
  };

  uart0: uart@60000000 {
   compatible = "espressif,esp32-uart";
   reg = <0x60000000 ((4) * 1024)>;
   status = "disabled";
   interrupts = <47 0 0>;
   interrupt-parent = <&intc>;
   clocks = <&clock 101>;
  };

  uart1: uart@60001000 {
   compatible = "espressif,esp32-uart";
   reg = <0x60001000 ((4) * 1024)>;
   status = "disabled";
   interrupts = <48 0 0>;
   interrupt-parent = <&intc>;
   clocks = <&clock 102>;
   current-speed = <115200>;
  };

  lp_uart: uart@600b1400 {
   compatible = "espressif,esp32-lpuart";
   reg = <0x600b1400 ((4) * 1024)>;
   interrupts = <16 0 0>;
   interrupt-parent = <&intc>;
   tx-pin = <5>;
   rx-pin = <4>;
   rts-pin = <2>;
   cts-pin = <3>;
   status = "disabled";
   current-speed = <115200>;
  };

  usb_serial: uart@6000f000 {
   compatible = "espressif,esp32-usb-serial";
   reg = <0x6000f000 0x1000>;
   status = "disabled";
   interrupts = <54 0 0>;
   interrupt-parent = <&intc>;
   clocks = <&clock 103>;
  };

  ledc0: ledc@60007000 {
   compatible = "espressif,esp32-ledc";
   pwm-controller;
   #pwm-cells = <3>;
   reg = <0x60007000 0x1000>;
   clocks = <&clock 100>;
   status = "disabled";
  };

  mcpwm0: mcpwm@60014000 {
   compatible = "espressif,esp32-mcpwm";
   reg = <0x60014000 ((4) * 1024)>;
   interrupts = <65 0 0>;
   interrupt-parent = <&intc>;
   clocks = <&clock 114>;
   #pwm-cells = <3>;
   status = "disabled";
  };

  pcnt: pcnt@60012000 {
   compatible = "espressif,esp32-pcnt";
   reg = <0x60012000 ((4) * 1024)>;
   interrupts = <66 0 0>;
   interrupt-parent = <&intc>;
   clocks = <&clock 107>;
   status = "disabled";
  };

  sha: sha@60089000 {
   compatible = "espressif,esp32-sha";
   reg = <0x60089000 0x100>;
   clocks = <&clock 121>;
   status = "okay";
  };

  aes: aes@60088000 {
   compatible = "espressif,esp32-aes";
   reg = <0x60088000 0x1000>;
   clocks = <&clock 120>;
   status = "okay";
  };
 };
};
