# 10 "C:/Users/mene_/zephyr/dts/vendor/espressif/partitions_0x2000_default_8M.dtsi" 3 4
&flash0 {
 partitions {
  ranges;
  #address-cells = <1>;
  #size-cells = <1>;

  boot_partition: partition@2000 {
   compatible = "zephyr,mapped-partition";
   label = "mcuboot";
   reg = <0x2000 ((56) * 1024)>;
  };

  sys_partition: partition@10000 {
   compatible = "zephyr,mapped-partition";
   label = "sys";
   reg = <0x10000 ((64) * 1024)>;
  };

  slot0_partition: partition@20000 {
   compatible = "zephyr,mapped-partition";
   label = "image-0";
   reg = <0x20000 ((3840) * 1024)>;
  };

  slot1_partition: partition@3e0000 {
   compatible = "zephyr,mapped-partition";
   label = "image-1";
   reg = <0x3e0000 ((3840) * 1024)>;
  };

  slot0_lpcore_partition: partition@7a0000 {
   compatible = "zephyr,mapped-partition";
   label = "image-0-lpcore";
   reg = <0x7a0000 ((32) * 1024)>;
  };

  slot1_lpcore_partition: partition@7a8000 {
   compatible = "zephyr,mapped-partition";
   label = "image-1-lpcore";
   reg = <0x7a8000 ((32) * 1024)>;
  };

  storage_partition: partition@7b0000 {
   compatible = "zephyr,mapped-partition";
   label = "storage";
   reg = <0x7b0000 ((192) * 1024)>;
  };

  scratch_partition: partition@7e0000 {
   compatible = "zephyr,mapped-partition";
   label = "image-scratch";
   reg = <0x7e0000 ((124) * 1024)>;
  };

  coredump_partition: partition@7ff000 {
   compatible = "zephyr,mapped-partition";
   label = "coredump";
   reg = <0x7ff000 ((4) * 1024)>;
  };
 };
};
